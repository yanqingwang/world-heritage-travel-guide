 "name_zh": "卡瓦利泽布日多夫斯津：自成一家的建筑景观朝圣园",
 "name_zh_source": "unesco_official",
 "name_en": "Kalwaria Zebrzydowska: the Mannerist Architectural and Park Landscape Complex and Pilgrimage Park",
 "name_local": "Sanktuarium pasyjno-maryjne w Kalwarii Zebrzydowskiej",
 "local_lang": "pl",
 "local_lang_name": "Polish",
 "slug": "905-kalwaria_zebrzydowska:_the_mannerist_arc",
