 "name_zh": "斯特鲁维地理探测弧线",
 "name_zh_source": "unesco_official",
 "name_en": "Struve Geodetic Arc",
 "name_local": "Геодезическая дуга Струве",
 "local_lang": "ru",
 "local_lang_name": "Russian",
 "slug": "1187-struve_geodetic_arc",
