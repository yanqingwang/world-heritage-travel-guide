 "name_zh": "莫斯科克里姆林宫和红场",
 "name_zh_source": "unesco_official",
 "name_en": "Kremlin and Red Square, Moscow",
 "name_local": "Московский Кремль и Красная Площадь",
 "local_lang": "ru",
 "local_lang_name": "Russian",
