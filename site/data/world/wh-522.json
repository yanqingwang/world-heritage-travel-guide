 "name_zh": "乌韦达和巴埃萨城文艺复兴时期的建筑群",
 "name_zh_source": "unesco_official",
 "name_en": "Renaissance Monumental Ensembles of Úbeda and Baeza",
 "name_local": "Conjuntos monumentales renacentistas de Úbeda y Baeza",
 "local_lang": "es",
 "local_lang_name": "Spanish",
