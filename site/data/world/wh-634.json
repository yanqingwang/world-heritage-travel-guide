 "name_zh": "科罗缅斯克的耶稣升天教堂",
 "name_zh_source": "unesco_official",
 "name_en": "Church of the Ascension, Kolomenskoye",
 "name_local": "Церковь Вознесения в Коломенском (Москва)",
