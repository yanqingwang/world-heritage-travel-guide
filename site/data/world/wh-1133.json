 "name_zh": "喀尔巴阡山脉及欧洲其它地区的原始山毛榉林",
 "name_zh_source": "unesco_official",
 "name_en": "Ancient and Primeval Beech Forests of the Carpathians and Other Regions of Europe",
 "name_local": "",
 "local_lang": "sq",
