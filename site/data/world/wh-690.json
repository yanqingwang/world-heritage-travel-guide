 "name_zh": "泽莱纳山的内波穆克圣约翰朝圣教堂",
 "name_zh_source": "unesco_official",
 "name_en": "Pilgrimage Church of St John of Nepomuk at Zelená Hora",
 "name_local": "Kostel svatého Jana Nepomuckého (Žďár nad Sázavou)",
 "local_lang": "cs",
