 "name_zh": "法伦的大铜山采矿区",
 "name_zh_source": "unesco_official",
 "name_en": "Mining Area of the Great Copper Mountain in Falun",
 "name_local": "Falun och Kopparbergslagen",
 "local_lang": "sv",
