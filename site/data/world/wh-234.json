 "subdivision_source": "wikidata_p131_p300",
 "name_zh": "果阿的教堂和修道院",
 "name_zh_source": "unesco_official",
 "name_en": "Churches and Convents of Goa",
 "name_local": "गोवा के चर्च और कॉन्वेंट",
 "local_lang": "hi",
 "local_lang_name": "Hindi",
 "slug": "234-churches_and_convents_of_goa",
 "lat": 15.5024,
