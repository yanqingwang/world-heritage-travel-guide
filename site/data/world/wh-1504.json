 "name_zh": "斯特茨中世纪墓碑墓地",
 "name_zh_source": "curated",
 "name_en": "Stećci Medieval Tombstone Graveyards",
 "name_local": "Srednjovjekovna groblja sa stećcima",
 "local_lang": "hr",
 "local_lang_name": "Croatian",
 "slug": "1504-stećci_medieval_tombstone_graveyards",
 "lat": 43.092213888,
