 "name_zh": "熏香之路——内盖夫的沙漠城镇",
 "name_zh_source": "unesco_official",
 "name_en": "Incense Route - Desert Cities in the Negev",
 "name_local": "דרך הבשמים (ישראל)",
 "local_lang": "he",
