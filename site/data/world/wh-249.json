 "name_zh": "默哈伯利布勒姆古迹群",
 "name_zh_source": "unesco_official",
 "name_en": "Group of Monuments at Mahabalipuram",
 "name_local": "महाबलीपुरम के स्मारकों का समूह",
 "local_lang": "hi",
 "local_lang_name": "Hindi",
 "slug": "249-group_of_monuments_at_mahabalipuram",
