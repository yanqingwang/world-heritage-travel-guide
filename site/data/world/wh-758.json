 "name_zh": "潘诺恩哈尔姆千年修道院及其自然环境",
 "name_zh_source": "unesco_official",
 "name_en": "Millenary Benedictine Abbey of Pannonhalma and its Natural Environment",
 "name_local": "Pannonhalmi Bencés Főapátság",
