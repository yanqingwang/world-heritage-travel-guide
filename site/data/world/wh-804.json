 "name_zh": "巴塞罗那的帕劳音乐厅及圣保罗医院",
 "name_zh_source": "unesco_official",
 "name_en": "Palau de la Música Catalana and Hospital de Sant Pau, Barcelona",
 "name_local": "Palau de la Música Catalana y hospital de Sant Pau en Barcelona",
