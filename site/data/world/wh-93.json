 "name_zh": "绘有达•芬奇《最后的晚餐》的圣玛丽亚感恩教堂和多明各会修道院",
 "name_zh_source": "unesco_official",
 "name_en": "Church and Dominican Convent of Santa Maria delle Grazie with “The Last Supper” by Leonardo da Vinci",
 "name_local": "Chiesa di Santa Maria delle Grazie (Milano)",
 "local_lang": "it",
 "local_lang_name": "Italian",
 "slug": "93-church_and_dominican_convent_of_santa_ma",
