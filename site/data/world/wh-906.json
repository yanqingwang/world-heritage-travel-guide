 "name_zh": "奥拉斯迪山的达亚恩城堡",
 "name_zh_source": "unesco_official",
 "name_en": "Dacian Fortresses of the Orastie Mountains",
 "name_local": "Fortărețe dacice din Munții Orăștiei",
 "local_lang": "ro",
 "local_lang_name": "Romanian",
 "slug": "906-dacian_fortresses_of_the_orastie_mountai",
 "lat": 45.6231,
