 "name_zh": "布达佩斯（多瑙河两岸、布达城堡区和安德拉什大街）",
 "name_zh_source": "unesco_official",
 "name_en": "Budapest, including the Banks of the Danube, the Buda Castle Quarter and Andrássy Avenue",
 "name_local": "Budapest világörökségi helyszínei",
 "local_lang": "hu",
