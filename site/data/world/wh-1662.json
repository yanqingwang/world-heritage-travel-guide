 "name_zh": "西贴古镇及相关陀罗钵地古迹",
 "name_zh_source": "unesco_official",
 "name_en": "The Ancient Town of Si Thep and its Associated Dvaravati Monuments",
 "name_local": "อุทยานประวัติศาสตร์ศรีเทพ",
 "local_lang": "th",
 "local_lang_name": "Thai",
 "slug": "1662-the_ancient_town_of_si_thep_and_its_asso",
 "lat": 15.46658533,
