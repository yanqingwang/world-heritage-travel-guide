 "name_zh": "莱德尼采－瓦尔季采文化景观",
 "name_zh_source": "unesco_official",
 "name_en": "Lednice-Valtice Cultural Landscape",
 "name_local": "Lednicko-valtický areál",
 "local_lang": "cs",
