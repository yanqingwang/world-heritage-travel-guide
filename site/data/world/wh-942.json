 "name_zh": "帕特莫斯岛的天启洞穴和圣约翰修道院",
 "name_zh_source": "unesco_official",
 "name_en": "The Historic Centre (Chorá) with the Monastery of Saint-John the Theologian and the Cave of the Apocalypse on the Island of Pátmos",
 "name_local": "Μονή του Αγίου Ιωάννου του Θεολόγου",
 "local_lang": "el",
 "local_lang_name": "Greek",
 "slug": "942-the_historic_centre_(chorá)_with_the_mon",
 "lat": 37.309188888,
