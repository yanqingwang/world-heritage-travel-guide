 "name_zh": "耶稣诞生地：伯利恒主诞堂和朝圣线路",
 "name_zh_source": "unesco_official",
 "name_en": "Birthplace of Jesus: Church of the Nativity and the Pilgrimage Route, Bethlehem",
 "name_local": "مهد ولادة يسوع المسيح: كنيسة المهد وطريق الحجاج، بيت لحم",
 "local_lang": "ar",
