 "name_zh": "埃森的关税同盟煤矿工业区",
 "name_zh_source": "unesco_official",
 "name_en": "Zollverein Coal Mine Industrial Complex in Essen",
 "name_local": "Zeche Zollverein",
 "local_lang": "de",
 "local_lang_name": "German",
