 "subdivision_source": "wikidata_p131_p300",
 "name_zh": "希尔德斯海姆的圣玛丽大教堂和圣米迦尔教堂",
 "name_zh_source": "unesco_official",
 "name_en": "St Mary's Cathedral and St Michael's Church at Hildesheim",
 "name_local": "Dom und Michaeliskirche in Hildesheim",
 "local_lang": "de",
